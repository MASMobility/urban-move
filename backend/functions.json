{
  "$comment": "One Lambda per handler. This list is consumed by packaging, Terraform and the tables of backend/README.md: it is the single source of routes, triggers, permissions and events. Validate it with `node .claude/skills/functions-registry/scripts/functions.mjs check`; the schema is in the functions-registry skill. `status: planned` = designed but without a handler yet; switch it to implemented (or remove the field) when you write the code.",
  "functions": [
    {
      "name": "identity-register",
      "service": "identity",
      "status": "planned",
      "description": "Registers credentials with the user role and emits UserRegistered; the profiles service creates the profile.",
      "entry": "identity/src/main/java/com/urbanmove/identity/RegisterUserHandler.java",
      "handler": "com.urbanmove.identity.RegisterUserHandler::handleRequest",
      "trigger": {"type": "http", "method": "POST", "path": "/auth/register"},
      "auth": ["public"],
      "uses": [
        {"kind": "dynamodb", "name": "identity-users", "access": "write"}
      ],
      "publishes": ["UserRegistered"]
    },
    {
      "name": "identity-login",
      "service": "identity",
      "status": "planned",
      "description": "Checks the credentials and returns a signed session token carrying the account role.",
      "entry": "identity/src/main/java/com/urbanmove/identity/LoginHandler.java",
      "handler": "com.urbanmove.identity.LoginHandler::handleRequest",
      "trigger": {"type": "http", "method": "POST", "path": "/auth/login"},
      "auth": ["public"],
      "uses": [
        {"kind": "dynamodb", "name": "identity-users", "access": "read"},
        {"kind": "secret", "name": "identity-signing-key", "access": "read"}
      ]
    },
    {
      "name": "identity-me",
      "service": "identity",
      "status": "planned",
      "description": "Returns the identity and role of the current session.",
      "entry": "identity/src/main/java/com/urbanmove/identity/GetCurrentUserHandler.java",
      "handler": "com.urbanmove.identity.GetCurrentUserHandler::handleRequest",
      "trigger": {"type": "http", "method": "GET", "path": "/auth/me"},
      "auth": ["user", "maintenance", "admin"],
      "uses": [
        {"kind": "dynamodb", "name": "identity-users", "access": "read"}
      ]
    },
    {
      "name": "identity-create-staff",
