{
  "$comment": "Una Lambda por handler. Esta lista la consumen el empaquetado, Terraform y las tablas de backend/README.md: es la única fuente de rutas, disparadores, permisos y eventos. Se valida con `node .claude/skills/functions-registry/scripts/functions.mjs check`; el esquema está en la skill functions-registry. `status: planned` = diseñada pero sin handler todavía; pásala a implemented (o quita el campo) al escribir el código.",
  "functions": [
    {
      "name": "identity-register",
      "service": "identity",
      "status": "planned",
      "description": "Da de alta unas credenciales con rol user y emite UserRegistered; el perfil lo crea el servicio de perfiles.",
      "entry": "identity/src/main/java/com/urbanmove/identity/RegisterUserHandler.java",
      "handler": "com.urbanmove.identity.RegisterUserHandler::handleRequest",
      "trigger": {"type": "http", "method": "POST", "path": "/auth/register"},
      "auth": ["public"],
      "uses": [
        {"kind": "dynamodb", "name": "identity-users", "access": "write"}
      ],
      "publishes": ["UserRegistered"]
    },
    {
      "name": "identity-login",
      "service": "identity",
      "status": "planned",
      "description": "Comprueba las credenciales y devuelve un token de sesión firmado con el rol de la cuenta.",
      "entry": "identity/src/main/java/com/urbanmove/identity/LoginHandler.java",
      "handler": "com.urbanmove.identity.LoginHandler::handleRequest",
      "trigger": {"type": "http", "method": "POST", "path": "/auth/login"},
      "auth": ["public"],
      "uses": [
        {"kind": "dynamodb", "name": "identity-users", "access": "read"},
        {"kind": "secret", "name": "identity-signing-key", "access": "read"}
      ]
    },
    {
      "name": "identity-me",
      "service": "identity",
      "status": "planned",
      "description": "Devuelve la identidad y el rol de la sesión actual.",
      "entry": "identity/src/main/java/com/urbanmove/identity/GetCurrentUserHandler.java",
      "handler": "com.urbanmove.identity.GetCurrentUserHandler::handleRequest",
      "trigger": {"type": "http", "method": "GET", "path": "/auth/me"},
      "auth": ["user", "maintenance", "admin"],
      "uses": [
        {"kind": "dynamodb", "name": "identity-users", "access": "read"}
      ]
    },
    {
      "name": "identity-create-staff",
      "service": "identity",
      "status": "planned",
      "description": "Crea una cuenta de mantenimiento o de administración; solo la puede pedir un administrador.",
